#!/bin/sh
# Imports one Happ subscription into Forkop 2.x; Forkop owns subsequent refreshes.
set -eu
umask 077
export LC_ALL=C
fail() { printf '%s\n' "$1"; exit 1; }
settings=/etc/happ-forkop/settings.json
lock=/var/lock/happ-forkop.lock
mkdir "$lock" 2>/dev/null || fail 'Импорт уже выполняется.'
tmp=''
trap 'test -z "$tmp" || rm -rf "$tmp"; rmdir "$lock" 2>/dev/null || :' EXIT
trap 'exit 1' HUP INT TERM
[ -x /usr/bin/hpwnr ] || fail 'Не установлен hpwnr.'
[ -f "$settings" ] || fail 'Сначала заполните форму.'
chmod 600 "$settings"
get() { jsonfilter -i "$settings" -e "@.$1" 2>/dev/null; }
link=$(get link) || fail 'Не удалось прочитать ссылку.'
owner=$(get section) || fail 'Выберите секцию Forkop.'
interval=$(get interval) || interval=1h
hwid=$(get hwid) || hwid=''
case "$link" in happ://crypt*/*) ;; *) fail 'Нужна ссылка happ://crypt…/…' ;; esac
[ "${#link}" -le 32768 ] || fail 'Ссылка слишком длинная.'
case "$owner" in ''|*[!a-zA-Z0-9_]*) fail 'Некорректная секция.' ;; esac
case "$interval" in 30m|1h|6h|12h|1d) ;; *) fail 'Некорректный интервал.' ;; esac
[ "$(uci -q get forkop.settings.config_version)" = '2.0.0' ] || fail 'Это дополнение требует формат настроек Forkop 2.0.0.'
[ "$(uci -q get "forkop.$owner")" = section ] || fail 'Секция Forkop не найдена.'
[ "$(uci -q get "forkop.$owner.action")" = connection ] || fail 'Выберите секцию с действием «Подключение».'
[ -z "$(uci changes forkop)" ] || fail 'Сначала примените несохранённые изменения Forkop.'
case "$hwid" in *[!a-zA-Z0-9_.:-]*) fail 'Недопустимые символы HWID.' ;; esac
if [ -z "$hwid" ]; then
 mac=$(cat /sys/class/net/eth0/address 2>/dev/null || cat /sys/class/net/br-lan/address 2>/dev/null || :)
 model=$(cat /tmp/sysinfo/model 2>/dev/null || printf 'OpenWrt Router')
 hash=$(printf '%s' "$mac-$model" | md5sum | cut -c1-16)
 hwid=$(printf '%s' "$hash" | sed 's/\(....\)\(....\)\(....\)\(....\)/\1-\2-\3-\4/')
fi
# Do not forward decoder diagnostics: they may contain credentials.
url=$(/usr/bin/hpwnr "$link" 2>/dev/null) || fail 'Не удалось расшифровать ссылку. Возможно, нужны новые ключи hpwnr.'
case "$url" in https://?*) ;; *) fail 'После расшифровки не получен HTTPS-адрес подписки.' ;; esac
case "$url" in *[[:space:]]*) fail 'Адрес подписки содержит пробелы или переносы строк.' ;; esac
tmp=$(mktemp -d /tmp/happ-forkop.XXXXXX)
mkdir "$tmp/delta"
cp /etc/config/forkop "$tmp/forkop"
before=$(sha256sum /etc/config/forkop)
u() { uci -c "$tmp" -t "$tmp/delta" "$@"; }
id=happ_bridge
existing=$(u -q get "forkop.$id" || :)
if [ -n "$existing" ]; then
 [ "$existing" = subscription_url ] && [ "$(u -q get "forkop.$id.happ_bridge_managed")" = 1 ] || fail 'Имя happ_bridge занято другой настройкой.'
 u delete "forkop.$id"
fi
u set "forkop.$id=subscription_url"
u set "forkop.$id.section=$owner"
u set "forkop.$id.url=$url"
u set "forkop.$id.tag=Happ"
u set "forkop.$id.happ_bridge_managed=1"
u set "forkop.$id.subscription_update_enabled=1"
u set "forkop.$id.subscription_update_interval=$interval"
u add_list "forkop.$id.header=User-Agent: Happ/4.6.0"
[ -z "$hwid" ] || u add_list "forkop.$id.header=X-HWID: $hwid"
u commit forkop
[ "$before" = "$(sha256sum /etc/config/forkop)" ] && [ -z "$(uci changes forkop)" ] || fail 'Настройки Forkop изменились во время импорта. Повторите.'
cp /etc/config/forkop /etc/happ-forkop/forkop.before-import
chmod 600 /etc/happ-forkop/forkop.before-import
# Stage on the same filesystem so replacing the configuration is atomic.
cp "$tmp/forkop" /etc/config/.forkop-happ-new
chmod 600 /etc/config/.forkop-happ-new
mv /etc/config/.forkop-happ-new /etc/config/forkop
if ! /etc/init.d/forkop reload >/dev/null 2>&1; then
 printf '%s\n' 'Подписка записана, но Forkop не смог применить настройки. Проверьте диагностику Forkop.'
 exit 2
fi
printf '%s\n' 'Подписка добавлена. Автообновление включено. Проверьте серверы в Forkop.'
